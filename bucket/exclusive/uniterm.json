{
    "version": "1.9.2",
    "description": "A modern cross-platform terminal emulator with a built-in autonomous AI Agent",
    "homepage": "https://uniterm.net",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ys-ll/uniterm/releases/download/v1.9.2/uniterm-windows-amd64-portable-v1.9.2.zip",
            "hash": "3267ee57a06757097883f13fc12416d8421c7f82fe811aa5ee8047f9e88e09c7"
        }
    },
    "shortcuts": [
        [
            "uniTerm.exe",
            "uniTerm"
        ]
    ],
    "post_install": [
        "$bsJson = \"$dir\\data\\bootstrap.json\"",
        "$bootstrap = if (Test-Path $bsJson) { Get-Content $bsJson -Raw | ConvertFrom-Json } else { @{} }",
        "$bootstrap.type = 'portable'",
        "$bootstrap | ConvertTo-Json -Compress | Set-Content $bsJson -Encoding ASCII",
        "$settingsJson = \"$dir\\data\\settings.json\"",
        "$settings = if (Test-Path $settingsJson) { Get-Content $settingsJson -Raw | ConvertFrom-Json } else { @{} }",
        "$settings.autoCheckUpdate = $false",
        "$settings | ConvertTo-Json -Compress -Depth 10 | Set-Content $settingsJson -Encoding ASCII"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/ys-ll/uniterm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ys-ll/uniterm/releases/download/v$version/uniterm-windows-amd64-portable-v$version.zip"
            }
        }
    }
}
