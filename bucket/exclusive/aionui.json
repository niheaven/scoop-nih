            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "checkver": {
        "url": "https://www.aionui.com/releases/latest.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
