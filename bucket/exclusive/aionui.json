{
    "version": "2.2.1",
    "description": "A free, open-source, Cowork app with AI Agents",
    "homepage": "https://www.aionui.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://static.aionui.com/releases/2.2.1/AionUi-2.2.1-win-x64.exe#/dl.7z",
            "hash": "sha512:e40e6ae457068105cd59778de10ffc9f33f68f503e307c97be082c927bc355ca34d9c34f8c490361cfc746286a06e7ee0b76fb2430817e01e03327fb7ee909c9",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://static.aionui.com/releases/2.2.1/AionUi-2.2.1-win-arm64.exe#/dl.7z",
            "hash": "ca68d8d7f81ffda75c3f13ff8dee63d1a8c34658cc1fc919b3aebed294b8444f",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "checkver": {
        "url": "https://www.aionui.com/releases/latest.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "https://www.aionui.com/releases/latest.yml",
                    "regex": "sha512:\\s*$base64"
                }
            },
            "arm64": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
