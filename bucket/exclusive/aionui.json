{
    "version": "2.2.2",
    "description": "A free, open-source, Cowork app with AI Agents",
    "homepage": "https://www.aionui.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://static.aionui.com/releases/2.2.2/AionUi-2.2.2-win-x64.exe#/dl.7z",
            "hash": "sha512:3dc4e4f7c90d1d02fd87d80be0908be43a835d3336d9d2bcb6a546e15eaa9cc0550fb01e3bd472d07a6371405c86493890327bc5a4d104929ab849047953f697",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://static.aionui.com/releases/2.2.2/AionUi-2.2.2-win-arm64.exe#/dl.7z",
            "hash": "84cf1678f34ff19001eadc242c2820f731e4e7b14f4325a6bd216c159e25b245",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "checkver": {
        "url": "https://www.aionui.com/releases/latest.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "https://www.aionui.com/releases/latest.yml",
                    "regex": "sha512:\\s*$base64"
                }
            },
            "arm64": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
