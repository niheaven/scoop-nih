            "hash": "sha512:7d5685d8535e8dd8d013ae4c8b5d27a03aeef01eb879c1e6dd1ca47c00b8c10513d8c723bb12782f356eeeacea193e9a2f33977af961b524e15408ae2d25bd8c",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://static.aionui.com/releases/2.1.56/AionUi-2.1.56-win-arm64.exe#/dl.7z",
            "hash": "981bb4f770dbd5f3e068819adb13f569477aa4b1b2755a477e981379a6e5dae8",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "checkver": {
        "url": "https://www.aionui.com/releases/latest.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "https://www.aionui.com/releases/latest.yml",
                    "regex": "sha512:\\s*$base64"
                }
            },
            "arm64": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
