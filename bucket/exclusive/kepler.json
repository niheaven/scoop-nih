            "hash": "sha512:477dc0c55ad0f6b25f9c3cc8dd4ddeb5f629dd205636907f3609d2fb4aece5fffca47bdef1eef9bfc80354e4b63b0f944b9d655bdccd3dd794c4ecad6b272a12",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.8.1/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:b47244aff63b378bc48691fd781501c0902276135b83fd609ba392c0ce57699e93fa97ddc5a0d3617653ce4d944f0b521d294af67090f64f01cc131dd646a54e",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
