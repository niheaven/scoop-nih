    "license": {
        "identifier": "Freeware",
        "url": "https://www.gitkraken.com/eula"
    },
    "architecture": {
        "64bit": {
            "url": "https://kepler.gitkraken.com/production/0.9.0/kepler-x64-setup.exe#/dl.7z",
            "hash": "sha512:bf6472c8dfc85da03c50ba68cc49bde3f2149c3bdefa247cfe84d3dee94c8f0d699e59cabc1c001aa8f4fd4eb359da632a96cc06f40e264dbdb4991c841565a9",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.9.0/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:f0520e256ff6e0236e547e8ecdf9625bac662dfe24f6c012ab1f7994529f2d8f044766b90b6b0b040deedad3df4d4d0226a1b41d9cf11164d072d60a0bb492fe",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
