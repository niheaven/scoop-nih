    },
    "architecture": {
        "64bit": {
            "url": "https://kepler.gitkraken.com/production/0.10.0/kepler-x64-setup.exe#/dl.7z",
            "hash": "sha512:56d4944032543961e7a3d4e749f148e8edbd99c6074da1c92926306720cde9c564efa7826e0609415683cd67e4ec3cfcaad3018562a0fcf9229e7eaefe45e126",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.10.0/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:32ee03fc143263357f22a5b3b571e30c9ae77715977a470fcab065b4d7de9b7dfcc5238b7c00fac0555d804ef302f9fc2f49647683a0ae7f3ee3c860a61a2c85",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
