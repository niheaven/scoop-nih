            "hash": "sha512:85c038fe78ff717144a551ac733d7928dc1f5daa8e9974bbfe8ec71076f2a054c1a1a309d3ba1e8b888a932032a76ae5b81feadf97d0b5f5a8742973c85427f3",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.12.0/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:9076049f765b418e979e6a60a41fcf5da1d4e51390abbf678c715ee8c2d6fe257e996e1bdc2255c4cd285e92ea1601c72a7e54dac4e0c8aadc50a578bbe8e3d3",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
