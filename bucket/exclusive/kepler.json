            "hash": "sha512:bb28b6c0d51e4902de0c9f5f26806ff20fd4a5efbb048b97475d87c815b10aa6724b7aa371f70efb8c6489cff8a5807ab8c84e8b463055df8a1aa9b752350003",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.9.1/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:df3fe50e5c0fe552bba5b0e0bc7570c4fe8e1415100ab5c4bacc7303281cbac3c4728dac56f2bce964db7405913344f30faee20e6fd3d436cd6227dcc8aca386",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
