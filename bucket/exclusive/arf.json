{
    "version": "0.7.1",
    "description": "Alternative R Frontend — a modern R console written in Rust",
    "homepage": "https://github.com/eitsupi/arf",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/eitsupi/arf/releases/download/v0.7.1/arf-console-x86_64-pc-windows-msvc.zip",
            "hash": "06773f184fb7f01415d616a15acf2535fd264fc859f8ccfada9f2010bc0f33b0"
        },
        "arm64": {
            "url": "https://github.com/eitsupi/arf/releases/download/v0.7.1/arf-console-aarch64-pc-windows-msvc.zip",
            "hash": "ef7fa659de870794d42e96ede87ac1b8b6d7333d70d2da3964ae5b1fd952854e"
        }
    },
    "bin": "arf.exe",
    "pre_install": "if (!(Test-Path \"$persist_dir\\arf.toml\")) { New-Item \"$dir\\arf.toml\" -ItemType File | Out-Null }",
    "env_set": {
        "ARF_CONFIG": "$dir\\arf.toml",
        "ARF_HISTORY_DIR": "$dir\\history"
    },
    "persist": [
        "arf.toml",
        "history"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/eitsupi/arf/releases/download/v$version/arf-console-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/eitsupi/arf/releases/download/v$version/arf-console-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
