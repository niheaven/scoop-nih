{
    "version": "0.7.2",
    "description": "Alternative R Frontend — a modern R console written in Rust",
    "homepage": "https://github.com/eitsupi/arf",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/eitsupi/arf/releases/download/v0.7.2/arf-console-x86_64-pc-windows-msvc.zip",
            "hash": "662c10e25b60b1e4eb426ad5082f3dc809715cd7e59333a50826a2f5c2ee4757"
        },
        "arm64": {
            "url": "https://github.com/eitsupi/arf/releases/download/v0.7.2/arf-console-aarch64-pc-windows-msvc.zip",
            "hash": "f064f3b9a5d59418f279b48f5cfdf546ed5669a0c63f76484ff676d80109194e"
        }
    },
    "bin": "arf.exe",
    "pre_install": "if (!(Test-Path \"$persist_dir\\arf.toml\")) { New-Item \"$dir\\arf.toml\" -ItemType File | Out-Null }",
    "env_set": {
        "ARF_CONFIG": "$dir\\arf.toml",
        "ARF_HISTORY_DIR": "$dir\\history"
    },
    "persist": [
        "arf.toml",
        "history"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/eitsupi/arf/releases/download/v$version/arf-console-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/eitsupi/arf/releases/download/v$version/arf-console-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
